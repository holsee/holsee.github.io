<% import Cherry.Theme.Helpers %><h1>Writing</h1>
<p class="lede">Notes from the bench, oldest habits first: Elixir and the BEAM, sorting
algorithms, talks worth an hour, and whatever was on the turntable.</p>
<%= for {year, posts} <- @posts |> Enum.group_by(& &1.meta.date.year) |> Enum.sort_by(fn {year, _} -> year end, :desc) do %><p class="year-rule"><%= year %></p>
<ul class="post-list">
<%= for post <- Enum.sort_by(posts, & &1.meta.date, {:desc, Date}) do %><li>
<time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= Date.to_iso8601(post.meta.date) %></time>
<a href="<%= post.url %>"><%= h(post.meta.title) %></a>
</li>
<% end %></ul>
<% end %>
