<% import Cherry.Theme.Helpers %><h1>The <%= h(@tag) %> story</h1>
<p class="story-lede">Everything tagged <em><%= h(@tag) %></em> across the whole site — work, projects, talks, and writing.</p>
<%= if @portfolio.positions != [] do %><section class="story-section">
<h2>Positions</h2>
<%= for position <- @portfolio.positions do %><article class="timeline-entry">
<h3><%= h(position.title) %> · <%= h(position.org) %></h3>
<p class="entry-meta"><%= format_range(position.started, position.ended) %></p>
<%= if position.highlights != [] do %><ul class="entry-highlights">
<%= for highlight <- position.highlights do %><li><%= h(highlight) %></li>
<% end %></ul>
<% end %></article>
<% end %></section>
<% end %><%= if @portfolio.projects != [] do %><section class="story-section">
<h2>Projects</h2>
<%= for project <- @portfolio.projects do %><article class="timeline-entry">
<h3><%= h(project.title) %></h3>
<p class="entry-meta"><%= format_range(project.started, project.ended) %><%= for link <- project.links do %> · <a href="<%= link.url %>"><%= h(link.label) %></a><% end %></p>
</article>
<% end %></section>
<% end %><%= if @portfolio.talks != [] do %><section class="story-section">
<h2>Talks</h2>
<%= for talk <- @portfolio.talks do %><article class="timeline-entry">
<h3><%= h(talk.title) %></h3>
<p class="entry-meta"><%= h(talk.event) %> · <%= format_month(talk.date) %><%= if talk.video do %> · <a href="<%= talk.video %>">Video</a><% end %><%= if talk.slides do %> · <a href="<%= talk.slides %>">Slides</a><% end %></p>
</article>
<% end %></section>
<% end %><%= if @portfolio.oss != [] do %><section class="story-section">
<h2>Open source</h2>
<ul class="oss-list">
<%= for oss <- @portfolio.oss do %><li><a href="<%= oss.repo %>"><%= h(oss.title) %></a> <span class="oss-role"><%= h(oss.role) %></span></li>
<% end %></ul>
</section>
<% end %><%= if @portfolio.education != [] do %><section class="story-section">
<h2>Education</h2>
<%= for education <- @portfolio.education do %><article class="timeline-entry">
<h3><%= h(education.title) %> · <%= h(education.institution) %></h3>
<p class="entry-meta"><%= format_range(education.started, education.ended) %></p>
</article>
<% end %></section>
<% end %><%= if @posts != [] do %><section class="story-section">
<h2>Writing</h2>
<ul class="post-list">
<%= for post <- @posts do %><li>
<time datetime="<%= Date.to_iso8601(post.meta.date) %>"><%= Date.to_iso8601(post.meta.date) %></time>
<a href="<%= post.url %>"><%= h(post.meta.title) %></a>
</li>
<% end %></ul>
</section>
<% end %>