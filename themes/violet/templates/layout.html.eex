<% import Cherry.Theme.Helpers %><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(@page_title) %> · <%= h(@site.title) %></title>
<%= @head_extra %><%= if @search do %><link rel="stylesheet" href="<%= href(@site, "pagefind/pagefind-ui.css") %>">
<% end %><link rel="stylesheet" href="<%= href(@site, "assets/site.css") %>">
<script>
/* No-flash: apply the stored theme before first paint. */
(function () {
  try {
    var t = localStorage.getItem("cherry-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) {}
})();
</script>
</head>
<body class="<%= @page_class %>">
<!--
THESIS: an engineer's archive read as a body of work, not a feed; it refuses
the centered-column dev blog and the near-black-plus-neon-accent dark theme.
OWN-WORLD: violet is the field, not the accent — the whole ground is soaked
in it (#150e1f), amber (#f0b354) is reserved for what you can act on, and a
monospace rail of dates, tags and years carries structure under Bricolage
Grotesque display and Literata prose.
STORY: a reader arriving on a 2014 post sees whose archive this is, moves
through it by era and subject, and leaves having read the thing they came for.
FIRST VIEWPORT: name set large, one line of what this is, then curated entry
points into the archive; the register itself grouped by year.
FORM: brief-pinned by the author (dark, purple, interesting typography, good
monospace) — a pinned direction beats the roll (seed 73b67177, assigned 4).
FINISH: unreviewed and undocumented is unfinished; this build ends with the
finish review, the verdict, and DESIGN.md.
-->
<header class="site-header">
<div class="wrap">
<a class="site-title" href="<%= href(@site, "") %>"><%= h(@site.title) %></a>
<nav class="site-nav"><%= for item <- @nav do %><a href="<%= item.href %>"><%= h(item.label) %></a>
<% end %>
<button class="theme-toggle" type="button" aria-label="Theme">
<svg data-theme-icon="auto" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 2 A6 6 0 0 1 8 14 Z" fill="currentColor" stroke="none"/></svg>
<svg data-theme-icon="light" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="display:none"><circle cx="8" cy="8" r="3.5"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M13 3l-1.4 1.4M4.4 11.6L3 13"/></svg>
<svg data-theme-icon="dark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="display:none"><path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a5 5 0 0 0 7 7Z"/></svg>
<span data-theme-label>auto</span>
</button>
<%= if @search do %><div id="search" class="site-search"></div>
<% end %></nav>
</div>
</header>
<main>
<div class="wrap">
<%= @inner %>
</div>
</main>
<footer class="site-footer">
<div class="wrap">
<span>© <%= h(@site.title) %></span>
<a href="<%= href(@site, "feed.xml") %>">RSS</a>
</div>
</footer>
<%= if @search do %><script src="<%= href(@site, "pagefind/pagefind-ui.js") %>"></script>
<script>
window.addEventListener("DOMContentLoaded", function () {
  new PagefindUI({ element: "#search", showImages: false });
  var input = document.querySelector("#search input");
  if (!input) return;
  var mac = /Mac|iP/.test(navigator.platform || "");
  input.setAttribute("placeholder", "Search (" + (mac ? "⌘" : "Ctrl+") + "K)");
  window.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      e.preventDefault();
      input.focus();
      input.select();
    }
  });
});
</script>
<% end %><script src="<%= href(@site, "assets/theme-toggle.js") %>" defer></script>
<script src="<%= href(@site, "assets/copy-code.js") %>" defer></script>
</body>
</html>
